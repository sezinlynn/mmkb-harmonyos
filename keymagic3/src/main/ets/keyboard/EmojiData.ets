export function emojiCategoryById(id: EmojiCategoryId): EmojiCategory {
  for (let index = 0; index < EMOJI_CATEGORIES.length; index++) {
    if (EMOJI_CATEGORIES[index].id === id) {
      return EMOJI_CATEGORIES[index];
    }
  }
  return EMOJI_CATEGORIES[1];
}

export const BUNDLED_EMOJI_COUNT: number = EMOJI_CATEGORIES.reduce(
  (count: number, category: EmojiCategory): number => count + category.emojis.length,
  0,
);
